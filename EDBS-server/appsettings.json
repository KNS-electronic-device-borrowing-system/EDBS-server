{
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST:localhost};Port=${DB_PORT:5432};Database=${DB_NAME:edbs};Username=${DB_USER:postgres};Password=${DB_PASSWORD}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EmailSettings": {
    "MailServer": "${MAIL_SERVER:smtp.gmail.com}",
    "MailPort": "${MAIL_PORT:587}",
    "SenderName": "Hệ Thống Mượn Trả Thiết Bị",
    "SenderEmail": "${SENDER_EMAIL}",
    "Password": "${MAIL_PASSWORD}"
  },
  "AllowedHosts": "*"
}
